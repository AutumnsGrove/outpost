.env
secrets.env
config.yaml
outpost.db
outpost.db-shm
outpost.db-wal
outpost.db.lock
# The built binaries live at the repo root. Anchored, because a bare `outpost`
# also matched cmd/outpost/ and silently ignored new files there.
/outpost
/outpost-arm64
# Fetched modpacks: one directory per profile, plus the .mrpack cache. Both the
# CLI and the page write here.
/pack/
/packs/

# Gradle's caches and outputs. The mod's sources are tracked; a decompiled
# Minecraft jar and 70 MB of remapped loom cache are not, and were committed by
# accident once.
/mod/.gradle/
/mod/build/
node_modules/
.wrangler/
web/node_modules/
web/.svelte-kit/
# The Fabric mod: Gradle's cache, its output, and a dev server's run directory.
# The built jar does not live in git — it goes to mc-assets/mods/ via `outpost
# publish`, which is the same path every other mod in the pack takes.
mod/.gradle/
mod/build/
mod/run/
