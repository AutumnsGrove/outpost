#cloud-config
# Outpost ephemeral Minecraft server.
#
# Everything that decides *when* this machine dies lives on the orchestrator, not
# here. This file only builds the server, joins it to the tailnet, and starts it.
# If you find yourself adding a loop or a timer to this template, put it in
# internal/orchestrator instead.

hostname: {{ .Hostname }}
manage_etc_hosts: true

package_update: true
package_upgrade: true

packages:
  - openjdk-17-jdk-headless
  - curl
  - tar
  - unzip
  - ufw

write_files:
  - path: /root/.config/rclone/rclone.conf
    permissions: '0600'
    content: |
      [r2]
      type = s3
      provider = Cloudflare
      access_key_id = {{ .R2AccessKey }}
      secret_access_key = {{ .R2SecretKey }}
      endpoint = https://{{ .R2AccountID }}.r2.cloudflarestorage.com
      # no_check_bucket: rclone HEADs the bucket first, and a token scoped to
      # these buckets answers 403 rather than 404 — so it decides the bucket is
      # missing and tries to CreateBucket, which fails AccessDenied. This flag
      # is Cloudflare's documented answer for scoped tokens.
      no_check_bucket = true

  - path: /etc/systemd/system/minecraft.service
    content: |
      [Unit]
      Description=Minecraft Server
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=minecraft
      WorkingDirectory=/opt/minecraft
      ExecStart=/opt/minecraft/start.sh
      Restart=on-failure
      RestartSec=10
      StandardOutput=append:/opt/minecraft/logs/service.log
      StandardError=append:/opt/minecraft/logs/service.log

      [Install]
      WantedBy=multi-user.target

runcmd:
  # --- rclone from Ubuntu is 1.60 and too old for R2: every upload answers 501
  # NotImplemented. Take the current static build for this machine's
  # architecture instead (the box may be amd64 or arm64, depending on which
  # server type had capacity).
  - |
    ARCH=$(dpkg --print-architecture)
    curl -fsSL -o /tmp/rclone.zip "https://downloads.rclone.org/rclone-current-linux-$ARCH.zip"
    unzip -qo /tmp/rclone.zip -d /tmp/rcx
    install -m 0755 "$(find /tmp/rcx -name rclone -type f | head -1)" /usr/local/bin/rclone
    /usr/local/bin/rclone version | head -1
    rm -rf /tmp/rclone.zip /tmp/rcx

  # --- tailnet first, so the orchestrator can reach this box as soon as it is up.
  # Two things learned on the first two real runs:
  #   * Ephemerality is a property of the auth key, NOT a flag here. 1.104.6
  #     answers "flag provided but not defined: -ephemeral" and skips the join.
  #   * --advertise-tags needs the tag to exist in the tailnet's ACLs with an
  #     owner. Without it: "requested tags [tag:outpost] are invalid or not
  #     permitted". So tags are only passed when config asks for them.
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --authkey={{ .TailscaleAuthKey }} --hostname={{ .Hostname }} {{ range .TailscaleTags }}--advertise-tags={{ . }} {{ end }}--accept-dns=false

  # --- firewall: Minecraft from anywhere, everything else only over the tailnet.
  # The port is the one server.properties is told to use below, not a literal.
  # Note what is NOT here: there is no rule opening port 22. SSH and RCON are
  # reached over tailscale0, which the next rule already permits. Leaving 22
  # open to the internet would make "only 25565 is public" untrue.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow {{ .MCPort }}/tcp comment 'minecraft'
  - ufw allow in on tailscale0
  - ufw --force enable

  # --- minecraft user and layout
  - useradd -m -s /bin/bash minecraft
  - mkdir -p /opt/minecraft/logs /opt/minecraft/mods /opt/minecraft/config
  # The pull below runs as `minecraft`, so it must own the tree BEFORE it runs.
  # Owning it afterwards is what the first real run did, and rclone could not
  # create a single file: "open /opt/minecraft/whitelist.json: permission denied".
  - chown -R minecraft:minecraft /opt/minecraft
  - mkdir -p /home/minecraft/.config/rclone
  - cp /root/.config/rclone/rclone.conf /home/minecraft/.config/rclone/rclone.conf
  - chown -R minecraft:minecraft /home/minecraft/.config

  # --- pull the prebuilt server, modpack and scripts from R2
  - sudo -u minecraft rclone copy r2:{{ .AssetBucket }}/server/ /opt/minecraft/ --exclude "world/**"
  - sudo -u minecraft rclone copy r2:{{ .AssetBucket }}/mods/ /opt/minecraft/mods/
  - sudo -u minecraft rclone copy r2:{{ .AssetBucket }}/config/ /opt/minecraft/config/
  - sudo -u minecraft rclone copy r2:{{ .AssetBucket }}/scripts/ /opt/minecraft/

  # --- restore the world (a single tarball, laid out by v1)
  #
  # The rule: a world that EXISTS in R2 and cannot be restored must stop the boot,
  # never fall through to a fresh one. Shutdown uploads whatever is in
  # /opt/minecraft/world over current/world.tar.gz, so a server that started on a
  # blank world because of a network blip would replace the real world on the way
  # out. Only a world that is verifiably ABSENT is allowed to be generated.
  #
  # Three traps, all found the hard way:
  #   * /tmp/world has to be owned by minecraft, because the rclone runs as that
  #     user and root's 0755 directory is not writable. Without the chown the
  #     restore silently failed and Minecraft generated a fresh world over the
  #     top of a real one.
  #   * Nothing is redirected to /dev/null. The first version swallowed the
  #     error and printed "no world in R2", which is a lie with a clean-looking
  #     log, so the failure was invisible for three sessions.
  #   * "Is it there?" is answered by LISTING the bucket, which can only fail for
  #     a real reason (credentials, network). Treating any failed copy as "no
  #     world" is how a blip becomes a wiped world.
  - |
    mkdir -p /tmp/world
    chown minecraft:minecraft /tmp/world
    if ! LISTING=$(sudo -u minecraft rclone lsf -R r2:{{ .WorldBucket }}); then
      echo "COULD NOT LIST THE WORLD BUCKET - not starting Minecraft over a world that may exist"
      touch /run/outpost-no-start
    elif echo "$LISTING" | grep -qx 'current/world.tar.gz'; then
      if sudo -u minecraft rclone copyto r2:{{ .WorldBucket }}/current/world.tar.gz /tmp/world/world.tar.gz && tar -xzf /tmp/world/world.tar.gz -C /opt/minecraft/; then
        echo "world restored"
      else
        echo "WORLD EXISTS IN R2 BUT COULD NOT BE RESTORED - not starting Minecraft"
        rm -rf /opt/minecraft/world
        touch /run/outpost-no-start
      fi
    else
      echo "no world in R2, Minecraft will generate one"
    fi
    rm -rf /tmp/world

  # --- RCON on, on this session's password
  - |
    SP=/opt/minecraft/server.properties
    sed -i 's/^enable-rcon=.*/enable-rcon=true/' "$SP"
    sed -i 's/^rcon.port=.*/rcon.port=25575/' "$SP"
    sed -i "s/^rcon.password=.*/rcon.password={{ .RCONPassword }}/" "$SP"
    grep -q '^enable-rcon=' "$SP" || echo 'enable-rcon=true' >> "$SP"
    grep -q '^rcon.password=' "$SP" || echo 'rcon.password={{ .RCONPassword }}' >> "$SP"
    sed -i 's/^server-port=.*/server-port={{ .MCPort }}/' "$SP"

  - chown -R minecraft:minecraft /opt/minecraft
  - chmod +x /opt/minecraft/*.sh
  - systemctl daemon-reload
  - |
    if [ -e /run/outpost-no-start ]; then
      echo "NOT STARTING MINECRAFT: the world could not be restored, see above. The orchestrator will time out and delete this server; the world in R2 is untouched."
    else
      systemctl enable minecraft
      systemctl start minecraft
    fi

final_message: "outpost {{ .Hostname }} up after $UPTIME seconds"
