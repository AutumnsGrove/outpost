# Copy to .env and fill in. Compose reads this file twice: for the ${...}
# interpolation in docker-compose.yml, and as the container's environment — which
# is where internal/config reads the six credentials from.
#
# Never commit .env (it is in .gitignore).

# The host port the daemon listens on, on loopback. `tailscale serve --bg 8896`
# on the host is the way in from the tailnet.
OUTPOST_PORT=8896

# The uid/gid that owns ./data and ./update-signal. Matches the deploy user, so
# packs and the database are written as them rather than as root.
OUTPOST_UID=1000
OUTPOST_GID=1000

# The image the container runs. Leave it unset for the floating :latest tag; the
# host update watcher rewrites this line to pin an exact digest, and removing the
# line is how a rollback un-pins.
# OUTPOST_IMAGE=ghcr.io/autumnsgrove/outpost:latest

# Which tag the watcher follows. Unset means "latest".
# OUTPOST_UPDATE_TAG=latest

# --- secrets -------------------------------------------------------------
# Hetzner Cloud API token (servers, plans, keys).
HETZNER_TOKEN=
# Cloudflare API token, scoped to the DNS zone in config.yaml: edit.
CF_TOKEN=
# A Tailscale auth key, ephemeral, reusable: the VPS joins with it.
TS_AUTHKEY=
# R2 credentials, scoped to the mc-assets and mc-worlds buckets.
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Bearer token for /api/*. Optional: the listener is loopback-only and the tailnet
# is the access control. Set it if another process on the box shares the tailnet
# but should not be able to spend money here.
OUTPOST_TOKEN=
